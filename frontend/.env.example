# Copy to .env.local (git-ignored) to override the committed mode files for your machine.
# Never put secrets (AI keys, DB passwords, service accounts) in VITE_ variables:
# everything prefixed with VITE_ is shipped to the browser.
#
# Committed mode files (no secrets in any of them):
#   .env.development  npm run dev        -> mock (demo data, demo sign-in)
#   .env.api          npm run dev:api    -> real backend through the dev proxy
#   .env.production   npm run build      -> real backend on the same origin under /api
#   .env.demo / .env.firebase            -> demo builds
#   .env.test                            -> Vitest

# "mock" -> in-memory demo data and demo sign-in (clearly labelled in the UI)
# "real" -> calls the backend at VITE_API_BASE_URL
VITE_API_MODE=real

# Base URL of the backend API. "/api" = same origin (reverse proxy in production, Vite proxy in dev:api).
# A different origin (e.g. https://api.okul.example/api) needs CORS with credentials on the backend.
VITE_API_BASE_URL=/api

# Dev server only (npm run dev:api): where /api requests are forwarded.
VITE_DEV_API_TARGET=http://localhost:3000

# "browser" -> clean URLs (/admin/students); requires the host to rewrite unknown paths to index.html
# "hash"    -> #/admin/students; works on any static host
# "memory"  -> no URL changes; used for the embedded single-file demo
VITE_ROUTER_MODE=browser

# Request timeout in milliseconds (AI generation endpoints always use 120000)
VITE_API_TIMEOUT_MS=15000

# Optional: the school's privacy notice (KVKK aydınlatma metni). https only; otherwise a built-in summary is shown.
VITE_PRIVACY_URL=

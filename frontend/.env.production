# `npm run build` — the production app talks to the real backend.
# The API is expected on the same origin under /api (reverse proxy); change VITE_API_BASE_URL if it is not.
# Never put secrets here: every VITE_ variable is shipped to the browser.
VITE_API_MODE=real
VITE_API_BASE_URL=/api
VITE_ROUTER_MODE=browser

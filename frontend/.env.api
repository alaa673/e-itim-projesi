# `npm run dev:api` — dev server against a backend running locally.
# Requests to /api are forwarded to VITE_DEV_API_TARGET by the Vite dev server, so the session
# cookie stays same-origin (no CORS setup needed while developing).
VITE_API_MODE=real
VITE_API_BASE_URL=/api
VITE_ROUTER_MODE=browser
VITE_DEV_API_TARGET=http://localhost:3000
